  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uAC1C\uC778\uC815\uBCF4\uCC98\uB9AC\uBC29\uCE68\n\n[\uC11C\uBE44\uC2A4\uBA85]\uC740
    \uC774\uC6A9\uC790\uC758 \uAC1C\uC778\uC815\uBCF4\uB97C \uC911\uC694\uD558\uAC8C
    \uC0DD\uAC01\uD558\uBA70 \uAC1C\uC778\uC815\uBCF4 \uBCF4\uD638\uBC95 \uB4F1 \uAD00\uB828
    \uBC95\uB839\uC744 \uC900\uC218\uD569\uB2C8\uB2E4. \uBCF8 \uAC1C\uC778\uC815\uBCF4\uCC98\uB9AC\uBC29\uCE68\uC740
    \uC11C\uBE44\uC2A4\uAC00 \uC5B4\uB5A4 \uAC1C\uC778\uC815\uBCF4\uB97C \uC5B4\uB5A0\uD55C
    \uBAA9\uC801\uC73C\uB85C \uCC98\uB9AC\uD558\uACE0 \uBCF4\uD638\uD558\uB294\uC9C0\uB97C
    \uC124\uBA85\uD569\uB2C8\uB2E4.\n\n\uC81C1\uC870 \uAC1C\uC778\uC815\uBCF4\uC758
    \uCC98\uB9AC \uBAA9\uC801\n\n[\uC11C\uBE44\uC2A4\uBA85]\uC740 \uB2E4\uC74C \uBAA9\uC801\uC73C\uB85C
    \uAC1C\uC778\uC815\uBCF4\uB97C \uCC98\uB9AC\uD569\uB2C8\uB2E4.\n\n\uD68C\uC6D0\uAC00\uC785
    \uC758\uC0AC \uD655\uC778 \uBC0F \uC774\uC6A9\uC790 \uC2DD\uBCC4\n\uC774\uBA54\uC77C
    \uC778\uC99D\uBC88\uD638 \uBC1C\uC1A1 \uBC0F \uC778\uC99D \uCC98\uB9AC\n\uB85C\uADF8\uC778,
    \uACC4\uC815 \uC720\uC9C0 \uBC0F \uACC4\uC815 \uBCF5\uAD6C\n\uBD80\uC815 \uAC00\uC785\uACFC
    \uBD80\uC815 \uC774\uC6A9 \uBC29\uC9C0\n\uAC8C\uC784 \uAE30\uB85D \uC800\uC7A5
    \uBC0F \uB7AD\uD0B9 \uC11C\uBE44\uC2A4 \uC81C\uACF5\n\uC774\uC6A9\uC790 \uBB38\uC758\uC640
    \uBBFC\uC6D0 \uCC98\uB9AC\n\uC11C\uBE44\uC2A4\uC758 \uC548\uC815\uC131 \uC720\uC9C0
    \uBC0F \uBCF4\uC548 \uC0AC\uACE0 \uB300\uC751\n\n\uAC1C\uC778\uC815\uBCF4\uB294
    \uC704 \uBAA9\uC801 \uC774\uC678\uC758 \uC6A9\uB3C4\uB85C \uC774\uC6A9\uD558\uC9C0
    \uC54A\uC2B5\uB2C8\uB2E4. \uCC98\uB9AC \uBAA9\uC801\uC774 \uBCC0\uACBD\uB418\uB294
    \uACBD\uC6B0\uC5D0\uB294 \uAC1C\uC778\uC815\uBCF4 \uBCF4\uD638\uBC95\u300D\uC5D0
    \uB530\uB77C \uD544\uC694\uD55C \uC870\uCE58\uB97C \uC2DC\uD589\uD569\uB2C8\uB2E4.\n\n\uC81C2\uC870
    \uCC98\uB9AC\uD558\uB294 \uAC1C\uC778\uC815\uBCF4 \uD56D\uBAA9\n\n[\uC11C\uBE44\uC2A4\uBA85]\uC740
    \uB2E4\uC74C \uAC1C\uC778\uC815\uBCF4\uB97C \uCC98\uB9AC\uD569\uB2C8\uB2E4.\n\n\uD68C\uC6D0\uC815\uBCF4\n\uC774\uBA54\uC77C
    \uC8FC\uC18C, \uB2C9\uB124\uC784, \uC554\uD638\uD654\uB41C \uBE44\uBC00\uBC88\uD638,
    \uC774\uC6A9\uC790 \uC2DD\uBCC4\uBC88\uD638\n\uC774\uBA54\uC77C \uC778\uC99D\uC815\uBCF4\n\uC774\uBA54\uC77C
    \uC8FC\uC18C, \uC778\uC99D\uBC88\uD638, \uBC1C\uAE09 \uC2DC\uAC01, \uB9CC\uB8CC
    \uC2DC\uAC01, \uC778\uC99D \uC131\uACF5 \uC5EC\uBD80 \uBC0F \uC0AC\uC6A9 \uC5EC\uBD80\n\uAC8C\uC784
    \uC774\uC6A9\uC815\uBCF4\n\uAC8C\uC784 \uC810\uC218, \uC0DD\uC874 \uC2DC\uAC04,
    \uB3C4\uB2EC \uC6E8\uC774\uBE0C, \uC880\uBE44 \uCC98\uCE58 \uC218, \uB7AD\uD0B9
    \uC815\uBCF4\n\uC790\uB3D9 \uC0DD\uC131 \uC815\uBCF4\n\uC811\uC18D \uC77C\uC2DC,
    IP \uC8FC\uC18C, \uB85C\uADF8\uC778 \uBC0F \uC624\uB958 \uAE30\uB85D\n\n[\uC11C\uBE44\uC2A4\uBA85]\uC740
    \uC8FC\uBBFC\uB4F1\uB85D\uBC88\uD638, \uC5EC\uAD8C\uBC88\uD638, \uC6B4\uC804\uBA74\uD5C8\uBC88\uD638
    \uBC0F \uC678\uAD6D\uC778\uB4F1\uB85D\uBC88\uD638\uC640 \uAC19\uC740 \uACE0\uC720\uC2DD\uBCC4\uC815\uBCF4\uB97C
    \uC218\uC9D1\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\n\n\uC81C3\uC870 \uAC1C\uC778\uC815\uBCF4\uC758
    \uCC98\uB9AC \uBC0F \uBCF4\uC720 \uAE30\uAC04\n\n[\uC11C\uBE44\uC2A4\uBA85]\uC740
    \uAC1C\uC778\uC815\uBCF4 \uCC98\uB9AC \uBAA9\uC801\uC744 \uB2EC\uC131\uD558\uB294
    \uB370 \uD544\uC694\uD55C \uAE30\uAC04 \uB3D9\uC548\uB9CC \uAC1C\uC778\uC815\uBCF4\uB97C
    \uBCF4\uC720\uD569\uB2C8\uB2E4.\n\n\uD68C\uC6D0\uC815\uBCF4: \uD68C\uC6D0 \uD0C8\uD1F4
    \uC2DC\uAE4C\uC9C0\n\uC774\uBA54\uC77C \uC778\uC99D\uBC88\uD638: \uBC1C\uAE09
    \uD6C4 [10\uBD84] \uB610\uB294 \uC778\uC99D \uC644\uB8CC \uC2DC\uAE4C\uC9C0\n\uAC00\uC785
    \uBBF8\uC644\uB8CC \uC778\uC99D\uC815\uBCF4: \uC778\uC99D\uBC88\uD638 \uB9CC\uB8CC
    \uD6C4 [24\uC2DC\uAC04] \uC774\uB0B4\n\uAC8C\uC784 \uBC0F \uB7AD\uD0B9 \uAE30\uB85D:
    \uD68C\uC6D0 \uD0C8\uD1F4 \uC2DC\uAE4C\uC9C0\n\uBD80\uC815 \uC774\uC6A9 \uBC29\uC9C0
    \uAE30\uB85D: \uCC98\uB9AC \uC644\uB8CC \uD6C4 [\uBCF4\uC720\uAE30\uAC04]\uAE4C\uC9C0\n\n\uC774\uC6A9\uC790\uC758
    \uAC1C\uC778\uC815\uBCF4\uAC00 \uBD88\uD544\uC694\uD558\uAC8C \uB41C \uACBD\uC6B0\uC5D0\uB294
    \uC9C0\uCCB4 \uC5C6\uC774 \uD30C\uAE30\uD569\uB2C8\uB2E4. \uB2E8, \uB2E4\uB978
    \uBC95\uB839\uC5D0 \uB530\uB77C \uBCF4\uC874\uD560 \uD544\uC694\uAC00 \uC788\uB294
    \uC815\uBCF4\uB294 \uD574\uB2F9 \uBC95\uB839\uC5D0\uC11C \uC815\uD55C \uAE30\uAC04
    \uB3D9\uC548 \uBCC4\uB3C4\uB85C \uBCF4\uAD00\uD569\uB2C8\uB2E4.\n\n\uC81C4\uC870
    \uAC1C\uC778\uC815\uBCF4\uC758 \uC81C3\uC790 \uC81C\uACF5\n\n[\uC11C\uBE44\uC2A4\uBA85]\uC740
    \uC6D0\uCE59\uC801\uC73C\uB85C \uC774\uC6A9\uC790\uC758 \uAC1C\uC778\uC815\uBCF4\uB97C
    \uC81C3\uC790\uC5D0\uAC8C \uC81C\uACF5\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\n\n\uB2E4\uB9CC
    \uB2E4\uC74C\uC758 \uACBD\uC6B0\uC5D0\uB294 \uAC1C\uC778\uC815\uBCF4\uB97C \uC81C\uACF5\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uC774\uC6A9\uC790\uAC00 \uC0AC\uC804\uC5D0
    \uB3D9\uC758\uD55C \uACBD\uC6B0\n\uBC95\uB960\uC5D0 \uD2B9\uBCC4\uD55C \uADDC\uC815\uC774
    \uC788\uB294 \uACBD\uC6B0\n\uBC95\uB839\uC0C1 \uC758\uBB34\uB97C \uC900\uC218\uD558\uAE30
    \uC704\uD558\uC5EC \uBD88\uAC00\uD53C\uD55C \uACBD\uC6B0\n\uAE09\uBC15\uD55C
    \uC0DD\uBA85\xB7\uC2E0\uCCB4\xB7\uC7AC\uC0B0\uC0C1 \uC774\uC775\uC744 \uC704\uD558\uC5EC
    \uD544\uC694\uD55C \uACBD\uC6B0\n\n\uAC1C\uC778\uC815\uBCF4\uB97C \uC81C3\uC790\uC5D0\uAC8C
    \uC81C\uACF5\uD558\uAC8C \uB418\uB294 \uACBD\uC6B0\uC5D0\uB294 \uC81C\uACF5\uBC1B\uB294
    \uC790, \uC81C\uACF5 \uBAA9\uC801, \uC81C\uACF5 \uD56D\uBAA9 \uBC0F \uBCF4\uC720\uAE30\uAC04\uC744
    \uC774\uC6A9\uC790\uC5D0\uAC8C \uC54C\uB9AC\uACE0 \uD544\uC694\uD55C \uC808\uCC28\uB97C
    \uC9C4\uD589\uD569\uB2C8\uB2E4.\n\n\uC81C5\uC870 \uAC1C\uC778\uC815\uBCF4 \uCC98\uB9AC\uC5C5\uBB34\uC758
    \uC704\uD0C1\n\n[\uC11C\uBE44\uC2A4\uBA85]\uC740 \uC774\uBA54\uC77C \uC778\uC99D\uBC88\uD638
    \uBC1C\uC1A1\uC744 \uC704\uD574 \uB2E4\uC74C \uC5C5\uCCB4\uC5D0 \uAC1C\uC778\uC815\uBCF4
    \uCC98\uB9AC\uC5C5\uBB34\uB97C \uC704\uD0C1\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uC218\uD0C1\uC790:
    [\uC774\uBA54\uC77C \uBC1C\uC1A1\uC5C5\uCCB4\uBA85]\n\uC704\uD0C1\uC5C5\uBB34:
    \uC774\uBA54\uC77C \uC778\uC99D\uBC88\uD638 \uBC0F \uC11C\uBE44\uC2A4 \uAD00\uB828
    \uC548\uB0B4 \uBA54\uC77C \uBC1C\uC1A1\n\uCC98\uB9AC\uD558\uB294 \uC815\uBCF4:
    \uC774\uBA54\uC77C \uC8FC\uC18C, \uC778\uC99D\uBC88\uD638\n\uBCF4\uC720 \uBC0F
    \uC774\uC6A9 \uAE30\uAC04: \uC704\uD0C1\uC5C5\uBB34 \uC885\uB8CC \uB610\uB294
    \uCC98\uB9AC \uBAA9\uC801 \uB2EC\uC131 \uC2DC\uAE4C\uC9C0\n\n[\uC11C\uBE44\uC2A4\uBA85]\uC740
    \uC704\uD0C1\uACC4\uC57D\uC744 \uCCB4\uACB0\uD560 \uB54C \uAC1C\uC778\uC815\uBCF4\uC758
    \uBAA9\uC801 \uC678 \uCC98\uB9AC \uAE08\uC9C0, \uC548\uC804\uC131 \uD655\uBCF4\uC870\uCE58,
    \uC7AC\uC704\uD0C1 \uC81C\uD55C, \uAD00\uB9AC\xB7\uAC10\uB3C5 \uBC0F \uC190\uD574\uBC30\uC0C1
    \uCC45\uC784\uC5D0 \uAD00\uD55C \uC0AC\uD56D\uC744 \uBB38\uC11C\uC5D0 \uBA85\uC2DC\uD569\uB2C8\uB2E4.\n\n\uC704\uD0C1\uC5C5\uCCB4
    \uB610\uB294 \uC704\uD0C1\uC5C5\uBB34\uAC00 \uBCC0\uACBD\uB418\uB294 \uACBD\uC6B0\uC5D0\uB294
    \uBCF8 \uAC1C\uC778\uC815\uBCF4\uCC98\uB9AC\uBC29\uCE68\uC744 \uD1B5\uD574 \uACF5\uAC1C\uD569\uB2C8\uB2E4.\n\n\uC81C6\uC870
    \uAC1C\uC778\uC815\uBCF4\uC758 \uAD6D\uC678 \uC774\uC804\n\n[\uC11C\uBE44\uC2A4\uBA85]\uC774
    \uD574\uC678\uC5D0 \uC11C\uBC84\uB97C \uB454 \uC774\uBA54\uC77C \uBC1C\uC1A1\uC5C5\uCCB4
    \uB610\uB294 \uD074\uB77C\uC6B0\uB4DC \uC11C\uBE44\uC2A4\uB97C \uC774\uC6A9\uD558\uC5EC
    \uAC1C\uC778\uC815\uBCF4\uB97C \uAD6D\uC678\uB85C \uC774\uC804\uD558\uB294 \uACBD\uC6B0\uC5D0\uB294
    \uB2E4\uC74C \uC0AC\uD56D\uC744 \uACF5\uAC1C\uD569\uB2C8\uB2E4.\n\n\uC774\uC804\uBC1B\uB294
    \uC790: [\uD574\uC678 \uC5C5\uCCB4\uBA85]\n\uC774\uC804 \uAD6D\uAC00: [\uAD6D\uAC00\uBA85]\n\uC774\uC804\uB418\uB294
    \uAC1C\uC778\uC815\uBCF4: [\uC774\uBA54\uC77C \uC8FC\uC18C \uB4F1]\n\uC774\uC804
    \uBAA9\uC801: \uC774\uBA54\uC77C \uC778\uC99D\uBC88\uD638 \uBC1C\uC1A1 \uB610\uB294
    \uC11C\uBC84 \uC6B4\uC601\n\uC774\uC804 \uC2DC\uAE30 \uBC0F \uBC29\uBC95: \uC778\uC99D
    \uC694\uCCAD \uC2DC \uC554\uD638\uD654\uB41C \uB124\uD2B8\uC6CC\uD06C\uB97C \uD1B5\uD55C
    \uC804\uC1A1\n\uBCF4\uC720 \uBC0F \uC774\uC6A9 \uAE30\uAC04: [\uC5C5\uCCB4\uC758
    \uC2E4\uC81C \uBCF4\uC720\uAE30\uAC04]\n\uAC1C\uC778\uC815\uBCF4 \uC774\uC804\uC744
    \uAC70\uBD80\uD558\uB294 \uBC29\uBC95\uACFC \uADF8\uC5D0 \uB530\uB978 \uBD88\uC774\uC775:
    [\uAC70\uBD80 \uBC29\uBC95 \uBC0F \uC11C\uBE44\uC2A4 \uC81C\uD55C \uB0B4\uC6A9]\n\n\uAD6D\uC678
    \uC774\uC804\uC774 \uC5C6\uB2E4\uBA74 \uC774 \uC870\uD56D\uC740 \uC0AD\uC81C\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uC81C7\uC870 \uAC1C\uC778\uC815\uBCF4\uC758
    \uD30C\uAE30\n\n[\uC11C\uBE44\uC2A4\uBA85]\uC740 \uAC1C\uC778\uC815\uBCF4\uC758
    \uBCF4\uC720\uAE30\uAC04\uC774 \uC9C0\uB098\uAC70\uB098 \uCC98\uB9AC \uBAA9\uC801\uC774
    \uB2EC\uC131\uB418\uB294 \uB4F1 \uAC1C\uC778\uC815\uBCF4\uAC00 \uBD88\uD544\uC694\uD558\uAC8C
    \uB41C \uACBD\uC6B0 \uC9C0\uCCB4 \uC5C6\uC774 \uD574\uB2F9 \uC815\uBCF4\uB97C
    \uD30C\uAE30\uD569\uB2C8\uB2E4.\n\n\uC804\uC790\uC801 \uD30C\uC77C \uD615\uD0DC\uC758
    \uAC1C\uC778\uC815\uBCF4\uB294 \uBCF5\uAD6C\uD558\uAC70\uB098 \uC7AC\uC0DD\uD560
    \uC218 \uC5C6\uB3C4\uB85D \uC548\uC804\uD55C \uBC29\uBC95\uC73C\uB85C \uC0AD\uC81C\uD569\uB2C8\uB2E4.
    \uC885\uC774 \uBB38\uC11C\uC5D0 \uAC1C\uC778\uC815\uBCF4\uAC00 \uAE30\uB85D\uB41C
    \uACBD\uC6B0\uC5D0\uB294 \uBD84\uC1C4\uD558\uAC70\uB098 \uC18C\uAC01\uD558\uC5EC
    \uD30C\uAE30\uD569\uB2C8\uB2E4.\n\n\uB2E4\uB978 \uBC95\uB839\uC5D0 \uB530\uB77C
    \uAC1C\uC778\uC815\uBCF4\uB97C \uACC4\uC18D \uBCF4\uC874\uD574\uC57C \uD558\uB294
    \uACBD\uC6B0\uC5D0\uB294 \uD574\uB2F9 \uC815\uBCF4\uB97C \uB2E4\uB978 \uAC1C\uC778\uC815\uBCF4\uC640
    \uBD84\uB9AC\uD558\uC5EC \uBCF4\uAD00\uD569\uB2C8\uB2E4.\n\n\uC81C8\uC870 \uC774\uC6A9\uC790\uC640
    \uBC95\uC815\uB300\uB9AC\uC778\uC758 \uAD8C\uB9AC\n\n\uC774\uC6A9\uC790\uB294
    \uC5B8\uC81C\uB4E0\uC9C0 \uC790\uC2E0\uC758 \uAC1C\uC778\uC815\uBCF4\uC5D0 \uB300\uD574
    \uB2E4\uC74C \uAD8C\uB9AC\uB97C \uD589\uC0AC\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uAC1C\uC778\uC815\uBCF4
    \uC5F4\uB78C \uC694\uAD6C\n\uAC1C\uC778\uC815\uBCF4 \uC815\uC815 \uB610\uB294
    \uC0AD\uC81C \uC694\uAD6C\n\uAC1C\uC778\uC815\uBCF4 \uCC98\uB9AC\uC815\uC9C0
    \uC694\uAD6C\n\uAC1C\uC778\uC815\uBCF4 \uCC98\uB9AC\uC5D0 \uB300\uD55C \uB3D9\uC758
    \uCCA0\uD68C\n\uD68C\uC6D0 \uD0C8\uD1F4 \uBC0F \uACC4\uC815 \uC0AD\uC81C \uC694\uAD6C\n\n\uB9CC
    14\uC138 \uBBF8\uB9CC \uC544\uB3D9\uC758 \uBC95\uC815\uB300\uB9AC\uC778\uC740
    \uD574\uB2F9 \uC544\uB3D9\uC758 \uAC1C\uC778\uC815\uBCF4\uC5D0 \uB300\uD574 \uC704
    \uAD8C\uB9AC\uB97C \uD589\uC0AC\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uAD8C\uB9AC
    \uD589\uC0AC\uB294 \uB2E4\uC74C \uC5F0\uB77D\uCC98\uB97C \uD1B5\uD574 \uC2E0\uCCAD\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uB2F4\uB2F9\uC790: [\uB2F4\uB2F9\uC790\uBA85]\n\uC774\uBA54\uC77C:
    [\uBB38\uC758 \uC774\uBA54\uC77C]\n\uC5F0\uB77D\uCC98: [\uC5F0\uB77D\uCC98]\n\n[\uC11C\uBE44\uC2A4\uBA85]\uC740
    \uC774\uC6A9\uC790\uC758 \uAD8C\uB9AC \uD589\uC0AC \uC694\uCCAD\uC744 \uD655\uC778\uD55C
    \uD6C4 \uAD00\uB828 \uBC95\uB839\uC5D0 \uB530\uB77C \uD544\uC694\uD55C \uC870\uCE58\uB97C
    \uC2DC\uD589\uD569\uB2C8\uB2E4.\n\n\uC81C9\uC870 \uAC1C\uC778\uC815\uBCF4\uC758
    \uC548\uC804\uC131 \uD655\uBCF4\uC870\uCE58\n\n[\uC11C\uBE44\uC2A4\uBA85]\uC740
    \uAC1C\uC778\uC815\uBCF4 \uBCF4\uD638\uB97C \uC704\uD574 \uB2E4\uC74C \uC870\uCE58\uB97C
    \uC2DC\uD589\uD569\uB2C8\uB2E4.\n\n\uAC1C\uC778\uC815\uBCF4 \uC811\uADFC \uAD8C\uD55C\uC758
    \uCD5C\uC18C\uD654\n\uBE44\uBC00\uBC88\uD638\uC758 \uC548\uC804\uD55C \uB2E8\uBC29\uD5A5
    \uC554\uD638\uD654\n\uC774\uBA54\uC77C \uC778\uC99D\uBC88\uD638\uC758 \uC81C\uD55C\uB41C
    \uC720\uD6A8\uAE30\uAC04 \uC124\uC815\n\uAC1C\uC778\uC815\uBCF4 \uC804\uC1A1
    \uAD6C\uAC04\uC758 \uC554\uD638\uD654\n\uAC1C\uC778\uC815\uBCF4 \uCC98\uB9AC\uC2DC\uC2A4\uD15C\uC5D0
    \uB300\uD55C \uC811\uADFC \uD1B5\uC81C\n\uC811\uC18D \uAE30\uB85D\uC758 \uBCF4\uAD00
    \uBC0F \uC704\xB7\uBCC0\uC870 \uBC29\uC9C0\n\uBCF4\uC548 \uD504\uB85C\uADF8\uB7A8\uC758
    \uC124\uCE58\uC640 \uC5C5\uB370\uC774\uD2B8\n\uAC1C\uC778\uC815\uBCF4 \uC720\uCD9C
    \uBC0F \uCE68\uD574\uC0AC\uACE0 \uB300\uC751 \uC808\uCC28 \uB9C8\uB828\n\uC81C10\uC870
    \uAC1C\uC778\uC815\uBCF4 \uBCF4\uD638\uCC45\uC784\uC790\n\n[\uC11C\uBE44\uC2A4\uBA85]\uC740
    \uAC1C\uC778\uC815\uBCF4 \uCC98\uB9AC\uC5C5\uBB34\uB97C \uCD1D\uAD04\uD558\uACE0
    \uC774\uC6A9\uC790\uC758 \uBD88\uB9CC \uBC0F \uD53C\uD574\uAD6C\uC81C\uB97C \uCC98\uB9AC\uD558\uAE30
    \uC704\uD558\uC5EC \uB2E4\uC74C\uACFC \uAC19\uC774 \uAC1C\uC778\uC815\uBCF4 \uBCF4\uD638\uCC45\uC784\uC790\uB97C
    \uC9C0\uC815\uD569\uB2C8\uB2E4.\n\n\uAC1C\uC778\uC815\uBCF4 \uBCF4\uD638\uCC45\uC784\uC790:
    \uC11C\uBE44\uC2A4 \uC6B4\uC601\uC790\n\uC774\uBA54\uC77C: [\uC774\uBA54\uC77C]\n\uC5F0\uB77D\uCC98:
    [\uC5F0\uB77D\uCC98]\n\uC81C11\uC870 \uAC1C\uC778\uC815\uBCF4 \uCE68\uD574 \uAD6C\uC81C\uBC29\uBC95\n\n\uAC1C\uC778\uC815\uBCF4
    \uCE68\uD574\uC640 \uAD00\uB828\uB41C \uC0C1\uB2F4 \uB610\uB294 \uD53C\uD574\uAD6C\uC81C\uAC00
    \uD544\uC694\uD55C \uACBD\uC6B0 \uB2E4\uC74C \uAE30\uAD00\uC5D0 \uBB38\uC758\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uAC1C\uC778\uC815\uBCF4\uCE68\uD574\uC2E0\uACE0\uC13C\uD130:
    \uAD6D\uBC88 \uC5C6\uC774 118\n\uAC1C\uC778\uC815\uBCF4\uBD84\uC7C1\uC870\uC815\uC704\uC6D0\uD68C:
    1833-6972\n\uACBD\uCC30\uCCAD \uC0AC\uC774\uBC84\uBC94\uC8C4 \uC2E0\uACE0\uC2DC\uC2A4\uD15C:
    \uAD6D\uBC88 \uC5C6\uC774 182\n\uC81C12\uC870 \uAC1C\uC778\uC815\uBCF4\uCC98\uB9AC\uBC29\uCE68\uC758
    \uBCC0\uACBD\n\n\uBCF8 \uAC1C\uC778\uC815\uBCF4\uCC98\uB9AC\uBC29\uCE68\uC740
