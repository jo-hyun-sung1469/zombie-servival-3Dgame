--- !u!114 &925577613
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 925577611}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uB9CC 14\uC138 \uBBF8\uB9CC \uC544\uB3D9\uC758 \uAC1C\uC778\uC815\uBCF4
    \uCC98\uB9AC \uC548\uB0B4\n\n[\uC11C\uBE44\uC2A4\uBA85]\uC774 \uB9CC 14\uC138
    \uBBF8\uB9CC \uC544\uB3D9\uC758 \uAC1C\uC778\uC815\uBCF4\uB97C \uCC98\uB9AC\uD558\uB294
    \uACBD\uC6B0 \uAC1C\uC778\uC815\uBCF4 \uBCF4\uD638\uBC95 \uC81C22\uC870\uC7582\uC5D0
    \uB530\uB77C \uBC95\uC815\uB300\uB9AC\uC778\uC758 \uB3D9\uC758\uB97C \uBC1B\uC544\uC57C
    \uD569\uB2C8\uB2E4.\n\n\uBC95\uC815\uB300\uB9AC\uC778\uC758 \uB3D9\uC758\uB97C
    \uD655\uC778\uD558\uAE30 \uC704\uD558\uC5EC \uB2E4\uC74C\uACFC \uAC19\uC740 \uCD5C\uC18C\uD55C\uC758
    \uC815\uBCF4\uB97C \uCC98\uB9AC\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uC544\uB3D9\uC758
    \uC774\uBA54\uC77C \uC8FC\uC18C \uBC0F \uB2C9\uB124\uC784\n\uBC95\uC815\uB300\uB9AC\uC778\uC758
    \uC131\uBA85\n\uBC95\uC815\uB300\uB9AC\uC778\uC758 \uC5F0\uB77D\uCC98\n\uBC95\uC815\uB300\uB9AC\uC778\uC758
    \uB3D9\uC758 \uC5EC\uBD80\uC640 \uB3D9\uC758 \uC77C\uC2DC\n\n\uBC95\uC815\uB300\uB9AC\uC778\uC5D0\uAC8C\uB294
    \uB2E4\uC74C \uC0AC\uD56D\uC744 \uC548\uB0B4\uD569\uB2C8\uB2E4.\n\n\uAC1C\uC778\uC815\uBCF4\uC758
    \uC218\uC9D1\xB7\uC774\uC6A9 \uBAA9\uC801\n\uC218\uC9D1\uD558\uB294 \uAC1C\uC778\uC815\uBCF4
    \uD56D\uBAA9\n\uAC1C\uC778\uC815\uBCF4\uC758 \uBCF4\uC720 \uBC0F \uC774\uC6A9
    \uAE30\uAC04\n\uB3D9\uC758\uB97C \uAC70\uBD80\uD560 \uAD8C\uB9AC\uC640 \uAC70\uBD80\uC5D0
    \uB530\uB978 \uBD88\uC774\uC775\n\uC544\uB3D9\uC758 \uAC1C\uC778\uC815\uBCF4\uC5D0
    \uB300\uD55C \uC5F4\uB78C\xB7\uC815\uC815\xB7\uC0AD\uC81C \uBC0F \uCC98\uB9AC\uC815\uC9C0
    \uC694\uAD6C \uBC29\uBC95\n\n\uBC95\uC815\uB300\uB9AC\uC778\uC758 \uB3D9\uC758\uAC00
    \uD655\uC778\uB418\uC9C0 \uC54A\uC73C\uBA74 \uB9CC 14\uC138 \uBBF8\uB9CC \uC544\uB3D9\uC758
    \uD68C\uC6D0\uAC00\uC785\uC744 \uC644\uB8CC\uD558\uC9C0 \uC54A\uC73C\uBA70, \uB3D9\uC758
    \uD655\uC778\uC744 \uC704\uD574 \uC784\uC2DC\uB85C \uC218\uC9D1\uD55C \uAC1C\uC778\uC815\uBCF4\uB294
    \uD655\uC778 \uAE30\uAC04\uC774 \uC885\uB8CC\uB41C \uD6C4 \uC9C0\uCCB4 \uC5C6\uC774
    \uD30C\uAE30\uD569\uB2C8\uB2E4.\n\n\uBC95\uC815\uB300\uB9AC\uC778\uC740 zombiesurvival3dgame@gmail.com\uC744
    \uD1B5\uD574 \uC544\uB3D9\uC758 \uAC1C\uC778\uC815\uBCF4\uC5D0 \uB300\uD55C \uC5F4\uB78C,
    \uC815\uC815, \uC0AD\uC81C, \uCC98\uB9AC\uC815\uC9C0 \uB610\uB294 \uB3D9\uC758
    \uCCA0\uD68C\uB97C \uC694\uAD6C\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 20ac305dbc15a3d4a835e5723f44a313, type: 2}
