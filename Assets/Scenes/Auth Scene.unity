--- !u!114 &296685207
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 296685205}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uC11C\uBE44\uC2A4 \uC774\uC6A9\uC57D\uAD00\r\n\r\n\uC81C1\uC870 \uBAA9\uC801\r\n\r\n\uBCF8
    \uC57D\uAD00\uC740 \uC11C\uBE44\uC2A4 \uC6B4\uC601\uC790\uAC00 \uC81C\uACF5\uD558\uB294
    [\uC11C\uBE44\uC2A4\uBA85]\uC758 \uC774\uC6A9 \uC870\uAC74, \uC774\uC6A9\uC790\uC640
    \uC11C\uBE44\uC2A4 \uC6B4\uC601\uC790\uC758 \uAD8C\uB9AC\xB7\uC758\uBB34 \uBC0F
    \uC11C\uBE44\uC2A4 \uC774\uC6A9\uC5D0 \uD544\uC694\uD55C \uC0AC\uD56D\uC744 \uADDC\uC815\uD558\uB294
    \uAC83\uC744 \uBAA9\uC801\uC73C\uB85C \uD569\uB2C8\uB2E4.\r\n\r\n\uC81C2\uC870
    \uD68C\uC6D0\uAC00\uC785\r\n\r\n\uC774\uC6A9\uC790\uB294 \uC11C\uBE44\uC2A4\uAC00
    \uC815\uD55C \uC808\uCC28\uC5D0 \uB530\uB77C \uC774\uBA54\uC77C \uC778\uC99D\uC744
    \uC644\uB8CC\uD558\uACE0 \uD68C\uC6D0\uAC00\uC785\uC744 \uC2E0\uCCAD\uD560 \uC218
    \uC788\uC2B5\uB2C8\uB2E4.\r\n\r\n\uC774\uC6A9\uC790\uB294 \uC815\uD655\uD558\uACE0
    \uCD5C\uC2E0\uC758 \uC815\uBCF4\uB97C \uC81C\uACF5\uD574\uC57C \uD558\uBA70,
    \uB2E4\uB978 \uC0AC\uB78C\uC758 \uC774\uBA54\uC77C \uC8FC\uC18C\uB098 \uACC4\uC815\uC744
    \uC774\uC6A9\uD558\uC5EC \uAC00\uC785\uD574\uC11C\uB294 \uC548 \uB429\uB2C8\uB2E4.\r\n\r\n\uC81C3\uC870
    \uACC4\uC815 \uAD00\uB9AC\r\n\r\n\uC774\uC6A9\uC790\uB294 \uC790\uC2E0\uC758
    \uACC4\uC815\uACFC \uBE44\uBC00\uBC88\uD638\uB97C \uC548\uC804\uD558\uAC8C \uAD00\uB9AC\uD560
    \uCC45\uC784\uC774 \uC788\uC2B5\uB2C8\uB2E4.\r\n\r\n\uACC4\uC815 \uB3C4\uC6A9\uC774\uB098
    \uBB34\uB2E8 \uC0AC\uC6A9\uC744 \uBC1C\uACAC\uD55C \uACBD\uC6B0\uC5D0\uB294 \uC989\uC2DC
    zombiesurvival3dgame@gmail.com\uB85C \uC54C\uB824\uC57C \uD569\uB2C8\uB2E4. \uC11C\uBE44\uC2A4
    \uC6B4\uC601\uC790\uB294 \uACC4\uC815 \uBCF4\uD638\uB97C \uC704\uD574 \uCD94\uAC00\uC801\uC778
    \uBCF8\uC778 \uD655\uC778\uC744 \uC694\uCCAD\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\r\n\uC81C4\uC870
    \uAE08\uC9C0\uD589\uC704\r\n\r\n\uC774\uC6A9\uC790\uB294 \uB2E4\uC74C \uD589\uC704\uB97C
    \uD574\uC11C\uB294 \uC548 \uB429\uB2C8\uB2E4.\r\n\r\n1. \uB2E4\uB978 \uC0AC\uB78C\uC758
    \uAC1C\uC778\uC815\uBCF4 \uB610\uB294 \uACC4\uC815\uC744 \uB3C4\uC6A9\uD558\uB294
    \uD589\uC704\r\n2. \uBE44\uC815\uC0C1\uC801\uC778 \uD504\uB85C\uADF8\uB7A8\uC774\uB098
    \uBC29\uBC95\uC73C\uB85C \uAC8C\uC784 \uAE30\uB85D\uC744 \uC870\uC791\uD558\uB294
    \uD589\uC704\r\n3. \uC11C\uBE44\uC2A4\uC758 \uC11C\uBC84 \uB610\uB294 \uB124\uD2B8\uC6CC\uD06C\uC5D0
    \uC7A5\uC560\uB97C \uBC1C\uC0DD\uC2DC\uD0A4\uB294 \uD589\uC704\r\n4. \uB2E4\uB978
    \uC774\uC6A9\uC790\uC758 \uC815\uC0C1\uC801\uC778 \uC11C\uBE44\uC2A4 \uC774\uC6A9\uC744
    \uBC29\uD574\uD558\uB294 \uD589\uC704\r\n5. \uAD00\uB828 \uBC95\uB839 \uB610\uB294
    \uACF5\uACF5\uC9C8\uC11C\uC5D0 \uC704\uBC18\uB418\uB294 \uD589\uC704\r\n6. \uC11C\uBE44\uC2A4\uC758
    \uCDE8\uC57D\uC810\uC744 \uC545\uC6A9\uD558\uAC70\uB098 \uAC1C\uC778\uC815\uBCF4\uB97C
    \uBB34\uB2E8\uC73C\uB85C \uC218\uC9D1\uD558\uB294 \uD589\uC704\r\n\r\n\uC81C5\uC870
    \uC774\uC6A9 \uC81C\uD55C\r\n\r\n\uC11C\uBE44\uC2A4 \uC6B4\uC601\uC790\uB294
    \uC774\uC6A9\uC790\uAC00 \uBCF8 \uC57D\uAD00\uC744 \uC704\uBC18\uD558\uAC70\uB098
    \uC11C\uBE44\uC2A4\uC758 \uC815\uC0C1\uC801\uC778 \uC6B4\uC601\uC744 \uBC29\uD574\uD55C
    \uACBD\uC6B0 \uACBD\uACE0, \uAE30\uB85D \uC0AD\uC81C, \uACC4\uC815 \uC774\uC6A9
    \uC81C\uD55C \uB610\uB294 \uD68C\uC6D0\uC790\uACA9 \uBC15\uD0C8 \uB4F1\uC758
    \uC870\uCE58\uB97C \uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\r\n\uC11C\uBE44\uC2A4
    \uC6B4\uC601\uC790\uB294 \uC774\uC6A9 \uC81C\uD55C \uC870\uCE58\uB97C \uC2DC\uD589\uD558\uB294
    \uACBD\uC6B0 \uC6D0\uCE59\uC801\uC73C\uB85C \uC0AC\uC720\uC640 \uAE30\uAC04\uC744
    \uC774\uC6A9\uC790\uC5D0\uAC8C \uC54C\uB9BD\uB2C8\uB2E4. \uB2E4\uB9CC \uAE34\uAE09\uD55C
    \uBCF4\uC548 \uC870\uCE58\uAC00 \uD544\uC694\uD55C \uACBD\uC6B0\uC5D0\uB294 \uC870\uCE58
    \uD6C4 \uC548\uB0B4\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\r\n\uC81C6\uC870
    \uAC8C\uC784 \uAE30\uB85D\uACFC \uB7AD\uD0B9\r\n\r\n\uC11C\uBE44\uC2A4\uB294
    \uC774\uC6A9\uC790\uC758 \uB2C9\uB124\uC784, \uC810\uC218, \uC0DD\uC874 \uC2DC\uAC04,
    \uB3C4\uB2EC \uC6E8\uC774\uBE0C \uBC0F \uCC98\uCE58 \uC218 \uB4F1\uC744 \uC800\uC7A5\uD558\uACE0
    \uB7AD\uD0B9\uC5D0 \uD45C\uC2DC\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\r\n\uBE44\uC815\uC0C1\uC801\uC778
    \uBC29\uBC95\uC73C\uB85C \uC0DD\uC131\uB418\uAC70\uB098 \uC870\uC791\uB41C \uAE30\uB85D\uC740
    \uC0AC\uC804 \uC548\uB0B4 \uD6C4 \uC0AD\uC81C\uD558\uAC70\uB098 \uB7AD\uD0B9\uC5D0\uC11C
    \uC81C\uC678\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\r\n\uC81C7\uC870 \uD68C\uC6D0
    \uD0C8\uD1F4\r\n\r\n\uC774\uC6A9\uC790\uB294 \uC5B8\uC81C\uB4E0\uC9C0 \uC11C\uBE44\uC2A4\uC5D0\uC11C
    \uD68C\uC6D0 \uD0C8\uD1F4\uB97C \uC694\uCCAD\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\r\n\uD68C\uC6D0
    \uD0C8\uD1F4\uAC00 \uC644\uB8CC\uB418\uBA74 \uD68C\uC6D0\uC815\uBCF4\uC640 \uC5F0\uACB0\uB41C
    \uAC8C\uC784 \uAE30\uB85D\uC740 \uC0AD\uC81C\uB429\uB2C8\uB2E4. \uB2E4\uB9CC
    \uBC95\uB839\uC5D0 \uB530\uB77C \uBCF4\uAD00\uD574\uC57C \uD558\uB294 \uC815\uBCF4
    \uB610\uB294 \uB2E4\uB978 \uC774\uC6A9\uC790\uC758 \uAD8C\uB9AC \uBCF4\uD638\uC640
    \uBD80\uC815 \uC774\uC6A9 \uBC29\uC9C0\uB97C \uC704\uD574 \uBCF4\uAD00\uC774
    \uD544\uC694\uD55C \uC815\uBCF4\uB294 \uBCC4\uB3C4\uC758 \uBC95\uC801 \uADFC\uAC70\uC640
    \uBCF4\uC720\uAE30\uAC04\uC5D0 \uB530\uB77C \uCC98\uB9AC\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\r\n\r\n\uC81C8\uC870
