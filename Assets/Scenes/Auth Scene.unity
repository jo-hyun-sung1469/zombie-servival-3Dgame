--- !u!114 &838833767
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 838833765}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uAC1C\uC778\uC815\uBCF4 \uC218\uC9D1\xB7\uC774\uC6A9 \uC548\uB0B4\n\n\uC11C\uBE44\uC2A4
    \uC6B4\uC601\uC790 [\uC11C\uBE44\uC2A4\uBA85]\uC758 \uD68C\uC6D0\uAC00\uC785
    \uBC0F \uC774\uBA54\uC77C \uC778\uC99D \uAE30\uB2A5\uC744 \uC81C\uACF5\uD558\uAE30
    \uC704\uD574\n\uC774\uC6A9\uC790\uC758 \uAC1C\uC778\uC815\uBCF4\uB97C \uB2E4\uC74C\uACFC
    \uAC19\uC774 \uCC98\uB9AC\uD569\uB2C8\uB2E4.\n\n1. \uCC98\uB9AC\uD558\uB294 \uAC1C\uC778\uC815\uBCF4\n\n\uC774\uBA54\uC77C
    \uC8FC\uC18C, \uC774\uBA54\uC77C \uC778\uC99D\uBC88\uD638\uC758 \uBC1C\uAE09
    \uC2DC\uAC01 \uBC0F \uB9CC\uB8CC \uC2DC\uAC01,\n\uC774\uBA54\uC77C \uC778\uC99D
    \uC5EC\uBD80, \uC778\uC99D \uC2DC\uB3C4 \uD69F\uC218\n\n\uC778\uC99D\uBC88\uD638\uC640
    \uBE44\uBC00\uBC88\uD638\uB294 \uC6D0\uBB38 \uADF8\uB300\uB85C \uC800\uC7A5\uD558\uC9C0
    \uC54A\uACE0\n\uBCF5\uAD6C\uD558\uAE30 \uC5B4\uB824\uC6B4 \uD615\uD0DC\uB85C
    \uC554\uD638\uD654\uD558\uAC70\uB098 \uD574\uC2DC \uCC98\uB9AC\uD558\uC5EC \uC800\uC7A5\uD569\uB2C8\uB2E4.\n\n2.
    \uAC1C\uC778\uC815\uBCF4\uC758 \uC774\uC6A9 \uBAA9\uC801\n\n\uC218\uC9D1\uB41C
    \uAC1C\uC778\uC815\uBCF4\uB294 \uB2E4\uC74C \uBAA9\uC801\uC73C\uB85C\uB9CC \uC774\uC6A9\uB429\uB2C8\uB2E4.\n\n-
    \uC774\uBA54\uC77C \uC778\uC99D\uBC88\uD638 \uBC1C\uC1A1\n- \uC774\uC6A9\uC790\uAC00
    \uD574\uB2F9 \uC774\uBA54\uC77C\uC744 \uC0AC\uC6A9\uD560 \uC218 \uC788\uB294
    \uC0AC\uB78C\uC778\uC9C0 \uD655\uC778\n\uD68C\uC6D0\uAC00\uC785 \uBC0F \uACC4\uC815
    \uC0DD\uC131\n\uB85C\uADF8\uC778\uACFC \uD68C\uC6D0 \uC2DD\uBCC4\n\uACC4\uC815
    \uBD84\uC2E4 \uC2DC \uACC4\uC815 \uBCF5\uAD6C\n\uBC18\uBCF5\uC801\uC778 \uC778\uC99D
    \uC694\uCCAD \uBC0F \uBD80\uC815\uD55C \uD68C\uC6D0\uAC00\uC785 \uBC29\uC9C0\n\uC11C\uBE44\uC2A4
    \uBCF4\uC548\uACFC \uC624\uB958 \uB300\uC751\n\n3. \uAC1C\uC778\uC815\uBCF4\uC758
    \uBCF4\uC720 \uBC0F \uC774\uC6A9 \uAE30\uAC04\n\n\uD68C\uC6D0 \uACC4\uC815\uC5D0
    \uB4F1\uB85D\uB41C \uC774\uBA54\uC77C \uC8FC\uC18C\uB294 \uD68C\uC6D0 \uD0C8\uD1F4
    \uC2DC\uAE4C\uC9C0 \uBCF4\uC720\uD569\uB2C8\uB2E4.\n\n\uD68C\uC6D0\uAC00\uC785\uC744
    \uC644\uB8CC\uD558\uC9C0 \uC54A\uC740 \uC774\uC6A9\uC790\uC758 \uC774\uBA54\uC77C
    \uC8FC\uC18C \uBC0F \uC774\uBA54\uC77C \uC778\uC99D\uC815\uBCF4\uB294 \uC778\uC99D
    \uC644\uB8CC \uB610\uB294 \uC778\uC99D \uC720\uD6A8\uAE30\uAC04 \uB9CC\uB8CC
    \uD6C4 [7\uC77C] \uC774\uB0B4\uC5D0 \uD30C\uAE30\uD569\uB2C8\uB2E4.\n\n\uBD80\uC815
    \uC774\uC6A9 \uBC29\uC9C0\uB97C \uC704\uD574 \uD544\uC694\uD55C \uC778\uC99D
    \uC2DC\uB3C4 \uAE30\uB85D\uC740 [30\uC77C] \uB3D9\uC548 \uBCF4\uAD00\uD55C \uD6C4
    \uD30C\uAE30\uD569\uB2C8\uB2E4. \uB2E4\uB9CC \uAD00\uACC4 \uBC95\uB839\uC5D0
    \uB530\uB77C \uBCF4\uC874\uD560 \uC758\uBB34\uAC00 \uC788\uB294 \uACBD\uC6B0\uC5D0\uB294
    \uD574\uB2F9 \uBC95\uB839\uC5D0\uC11C \uC815\uD55C \uAE30\uAC04 \uB3D9\uC548
    \uBCC4\uB3C4\uB85C \uBCF4\uAD00\uD569\uB2C8\uB2E4.\n\n4. \uAC1C\uC778\uC815\uBCF4
    \uCC98\uB9AC\uC758 \uBC95\uC801 \uADFC\uAC70\n\n\uC774\uBA54\uC77C \uC8FC\uC18C\uC640
    \uC774\uBA54\uC77C \uC778\uC99D\uC815\uBCF4\uB294 \uD68C\uC6D0\uAC00\uC785 \uBC0F
    \uACC4\uC815 \uC11C\uBE44\uC2A4 \uC81C\uACF5\uC5D0 \uD544\uC694\uD55C \uAC1C\uC778\uC815\uBCF4\uB85C\uC11C
    \uAC1C\uC778\uC815\uBCF4 \uBCF4\uD638\uBC95 \uC81C15\uC870 \uC81C1\uD56D \uC81C4\uD638\uC5D0
    \uB530\uB77C \uCC98\uB9AC\uD569\uB2C8\uB2E4.\n\n[\uC11C\uBE44\uC2A4\uBA85]\uC740
    \uAC1C\uC778\uC815\uBCF4 \uCC98\uB9AC \uBAA9\uC801\uC5D0 \uD544\uC694\uD55C \uCD5C\uC18C\uD55C\uC758
    \uAC1C\uC778\uC815\uBCF4\uB9CC \uCC98\uB9AC\uD558\uBA70, \uC218\uC9D1 \uBAA9\uC801\uACFC
    \uAD00\uACC4\uC5C6\uB294 \uC6A9\uB3C4\uB85C \uC0AC\uC6A9\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\n\n5.
    \uAC1C\uC778\uC815\uBCF4 \uC81C\uACF5\uC744 \uC6D0\uD558\uC9C0 \uC54A\uB294 \uACBD\uC6B0\n\n\uC774\uC6A9\uC790\uB294
    \uC774\uBA54\uC77C \uC8FC\uC18C\uB97C \uC81C\uACF5\uD558\uC9C0 \uC54A\uC744 \uC218
    \uC788\uC2B5\uB2C8\uB2E4. \uB2E4\uB9CC \uC774\uBA54\uC77C \uC8FC\uC18C\uB97C
    \uC81C\uACF5\uD558\uC9C0 \uC54A\uC73C\uBA74 \uC774\uBA54\uC77C \uC778\uC99D\uC774
    \uD544\uC694\uD55C \uD68C\uC6D0\uAC00\uC785, \uB85C\uADF8\uC778 \uBC0F \uACC4\uC815
    \uBCF5\uAD6C \uAE30\uB2A5\uC744 \uC774\uC6A9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\n\n\uC2DC\uD589\uC77C:
    2026\uB144 9\uC6D4 16\uC77C"
